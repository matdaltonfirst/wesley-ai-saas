# Copy to .env for local development. Nothing here is a real secret.
# The app starts with only SECRET_KEY set; each integration switches on when its
# own variables are present and shows "not enabled on this server" otherwise.

# ── Required ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string

# ── Local data (SQLite). Leave DATABASE_URL unset locally. ──────────────────
# On Railway, DATABASE_URL is injected by the Postgres service and DATA_DIR is
# the volume mount (it holds uploaded documents).
# DATA_DIR=./data
# DATABASE_URL=

# ── The organization (seeds a brand-new database only) ──────────────────────
# ORG_NAME=Dalton First United Methodist Church
# ORG_CITY=Dalton, GA
# Only email addresses on this domain may sign in, checked server-side.
# ORG_DOMAIN=daltonfumc.com
# DEFAULT_TIMEZONE=America/New_York

# ── AI (Google Gemini). Without a key the chat endpoints return an error. ───
GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite
# GEMINI_FALLBACK_MODEL=gemini-2.5-flash
# Semantic retrieval. EMBEDDINGS_ENABLED=0 reverts to keyword scoring.
# EMBEDDINGS_ENABLED=1
# EMBED_SIMILARITY_FLOOR=0.60
# EMBED_RELATIVE_BAND=0.94

# ── Sign-in: Google Workspace (OAuth client from Google Cloud Console) ─────
# Create an OAuth 2.0 Web client; authorized redirect URI: <APP_URL>/auth/google/callback
# While these are unset, password sign-in stays on. Once set, passwords are off.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# SESSION_IDLE_HOURS=8
# SESSION_ABSOLUTE_HOURS=24

# ── Public chatbot protection ───────────────────────────────────────────────
# Hosts allowed to call the public chat from a browser (subdomains included).
# PUBLIC_ALLOWED_ORIGINS=daltonfumc.com
# Total public AI calls per day before the chat rests until midnight UTC.
# PUBLIC_DAILY_CAP=3000

# ── YouTube (sermon ingestion): a YouTube Data API v3 key ───────────────────
# YOUTUBE_API_KEY=

# ── Planning Center (OAuth app registered at api.planningcenteronline.com) ──
# Redirect URI: <APP_URL>/pco/callback
# PCO_CLIENT_ID=
# PCO_CLIENT_SECRET=
# Encrypts stored tokens. Keep it stable: changing it orphans saved connections.
# PCO_TOKEN_ENCRYPTION_KEY=

# ── Email (Resend) ──────────────────────────────────────────────────────────
# RESEND_API_KEY=
# FROM_EMAIL=Wesley AI <noreply@wesleyai.co>
# SUPPORT_EMAIL=info@wesleyai.co

# ── Comms request triage explanation (optional; needs `pip install anthropic`)
# ANTHROPIC_API_KEY=

# ── Web and deploy ──────────────────────────────────────────────────────────
# APP_URL=https://app.wesleyai.co
# Set to 1 when served over HTTPS so the session cookie is Secure.
# SESSION_COOKIE_SECURE=0
# gunicorn workers. More than 1 requires Postgres (the scheduler lock uses it).
# WEB_CONCURRENCY=1

# ── Used only by the one-time single-organization migration ─────────────────
# ORG_SOURCE_CHURCH_ID=2
# ORG_MERGE_CHURCH_IDS=6
# WESLEY_CONFIRM_DROP_TENANTS=yes
