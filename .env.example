GEMINI_API_KEY=your_gemini_api_key_here
SECRET_KEY=change-me-to-a-long-random-string
# DATA_DIR=/app/data   # set this in Railway to the volume mount path

# Semantic retrieval (embeddings). Defaults are calibrated for
# gemini-embedding-001; EMBEDDINGS_ENABLED=0 reverts every church to keyword
# scoring without a deploy.
# EMBEDDINGS_ENABLED=1
# EMBED_SIMILARITY_FLOOR=0.60
# EMBED_RELATIVE_BAND=0.94
